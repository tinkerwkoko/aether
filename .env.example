# Aether - environment variable template.
# Copy this file to .env.local and fill in the values locally.
# Names only: never commit real values.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (server only - never prefix these with NEXT_PUBLIC_)
# Until a sender domain is verified in Resend, only the account owner's email
# address can receive test emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
